# Supabase (public browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# OmnifyAnime API (server-only; never prefix with NEXT_PUBLIC_)
OMNIFY_API_BASE=https://anime.omnifylabs.sbs
OMNIFY_API_KEY=YOUR_PRIVATE_API_KEY
# Aktifkan hanya setelah hak distribusi sumber video dikonfirmasi oleh penyedia.
STREAMING_RIGHTS_CONFIRMED=false
# Daftar hostname resmi yang diizinkan, pisahkan dengan koma. Contoh: video.example.com
OMNIFY_ALLOWED_STREAM_HOSTS=
# Isi hanya dengan host yang memang Anda miliki atau telah diberi izin distribusi.
# Contoh format: media.domain-anda.com,cdn.domain-anda.com
